# Origin of the Stayzy FastAPI service (no /v1 suffix). HTTPS required in production.
STAYZY_API_BASE_URL=http://127.0.0.1:8000
# Generate a random secret, e.g. openssl rand -base64 32. Minimum 32 characters.
STAYZY_SESSION_SECRET=
# Optional App Store URL override. Defaults to the published Stayzy iOS app.
STAYZY_APP_STORE_URL=https://apps.apple.com/us/app/stayzy/id6808848074
